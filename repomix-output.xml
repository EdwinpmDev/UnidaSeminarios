  <link rel='stylesheet' href='./css/compat.css'>
</head>

<body>

  <header>
    <h1>INSTITUTO TECNOLÓGICO DE VERACRUZ</h1>
    <p>UNIDA — Centro de Maestrías y Doctorados</p>
  </header>

  <main>
    <div class="folder-container">

      <div class="folder-tabs">
        <button id="btn-tab-profesor" class="tab-button active" data-rol="profesor">Profesor
          UNIDA</button>
        <button id="btn-tab-estudiante" class="tab-button"
          data-rol="estudiante">Estudiante UNIDA</button>
        <button id="btn-tab-evaluador" class="tab-button"
          data-rol="evaluador">Evaluador Externo</button>
      </div>

      <div class="folder-body">

        <!-- TAB PROFESOR -->
        <div id="tab-profesor" class="tab-content active">
          <form class="login-form" action="/login-profesor" method="POST">
            <h3>Profesor UNIDA</h3>
            <p class="form-subtitle">Gestión de alumnos, asignación de jurados y reportes.</p>

            <div class="input-group">
              <label for="user-profesor">Correo Institucional / Usuario</label>
              <input type="text" id="user-profesor" name="username" placeholder="ejemplo@veracruz.tecnm.mx" required />
            </div>

            <div class="input-group">
              <label for="pass-profesor">Contraseña</label>
              <div class="password-container">
                <input type="password" id="pass-profesor" name="password" placeholder="••••••••" required />
                <button type="button" class="btn-toggle-password" tabindex="-1" title="Mostrar contraseña">👁️</button>
              </div>
            </div>

            <button type="submit" class="btn-submit">Iniciar sesión</button>
            <p class="login-error hidden"></p>
          </form>
        </div>

        <!-- TAB ESTUDIANTE -->
        <div id="tab-estudiante" class="tab-content">

          <!-- 1. LOGIN DE ESTUDIANTE AL PORTAL -->
          <div id="sub-form-estudiante" class="sub-form-content active">
            <form class="login-form" action="/login-estudiante" method="POST">
              <h3>Acceso Estudiantes</h3>
              <p class="form-subtitle">Consulta de fechas asignadas, estatus y evaluaciones.</p>

              <div class="input-group">
                <label for="usuarioAlumno">No. de Control</label>
                <input type="text" id="usuarioAlumno" name="username" placeholder="12345678" required />
              </div>

              <div class="input-group">
                <label for="pass-estudiante">Contraseña</label>
