              </div>

              <button type="submit" class="btn-submit">Ingresar al portal</button>
              <p class="login-error hidden"></p>
            </form>

            <div class="switch-role-container">
              <button type="button" class="btn-switch-link" data-subrol="invitado">
                ¿Evaluar a un compañero? Ingresa aquí
              </button>
              <button type="button" class="btn-switch-link" data-subrol="registro" style="margin-top: 10px; display: block; width: 100%;">
                ¿Nuevo ingreso? Crea tu cuenta aquí
              </button>
            </div>
          </div>

          <!-- 2. REGISTRO DE CUENTA NUEVA -->
