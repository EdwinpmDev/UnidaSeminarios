        <div style="background: white; border-radius: 10px; max-width: 650px; width: 100%; max-height: 85vh; overflow-y: auto; padding: 25px; position: relative;">
            <button type="button" id="btnCerrarModalComentarios"
                style="position:absolute; top:12px; right:12px; background:none; border:none; font-size:1.2rem; cursor:pointer; color: var(--muted);">✕</button>
            <h3 style="color: var(--primary); margin-bottom: 15px;">Comentarios de evaluadores</h3>
