<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registro de seminario</title>
    <link rel="stylesheet" href="./css/usuario.css">
</head>

<body>
    <!-- OVERLAY DE LOGIN -->
    <div id="loginOverlay" class="hidden" aria-modal="true" role="dialog" aria-labelledby="loginTitle">
        <div id="loginBox">
            <h2 id="loginTitle">Iniciar sesión</h2>
            <div class="grid">
                <div>
                    <label for="loginUser">Usuario o correo</label>
                    <input type="email" id="loginUser" placeholder="usuario@dominio" autocomplete="username">
                </div>
                <div>
                    <label for="loginPass">Contraseña</label>
                    <div class="password-container">
                        <input type="password" id="loginPass" placeholder="••••••••"
                            autocomplete="current-password">
                        <button type="button" class="btn-toggle-password" tabindex="-1"
                            title="Mostrar contraseña">👁️</button>
                    </div>
                </div>
            </div>
            <div id="loginError" class="hidden" style="color: var(--error); font-size: 0.9rem; margin-top: 8px;">
            </div>
            <div class="row-actions" style="margin-top:10px;">
                <button id="btnDoLogin" type="button">Entrar</button>
            </div>
        </div>
    </div>

    <header>
        <div class="brand-left">
            <img src="./assets/img/tecnmBlanco.png" alt="Logo TecNM">
        </div>
        <div class="brand-center">
            <img src="./assets/img/itv.png" alt="itv logo">
        </div>
        <h1>Registro de seminario</h1>
        <p>Captura paso a paso los datos del estudiante y su evaluación</p>
        <p style="margin-top: 6px;">Sesión iniciada como: <strong id="nombre-usuario-header">...</strong></p>
    </header>

    <main class="container">

        <!-- PANTALLA 1: FORMULARIOS DE REGISTRO Y ADMIN -->
        <div id="vista-formulario">

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-bottom: 15px;">
                <button type="button" id="btnVerAgenda"
                    style="background: #2563eb; padding: 10px 15px; border-radius: 6px; color: white; border: none; font-weight: bold; cursor: pointer;">Ver
                    agenda 📅</button>
                <button type="button" id="btnVerDirectorio"
                    style="background: #4b5563; padding: 10px 15px; border-radius: 6px; color: white; border: none; font-weight: bold; cursor: pointer;">Ver
                    directorio alumnos📋</button>
            </div>

            <section class="card">
                <div class="steps" aria-hidden="true">
                    <div class="step step-1 active">Paso 1: Datos básicos</div>
                    <div class="step step-2">Paso 2: Seminario</div>
                </div>

                <form id="formSeminario" novalidate>

                    <!-- PASO 1 -->
                    <fieldset id="fsPaso1">
                        <legend>1) Datos básicos del estudiante</legend>
                        <!-- botón para seleccionar alumno existente -->
                        <div
                            style="background: #eff6ff; padding: 12px; border-radius: 8px; border: 1px dashed var(--primary); margin-bottom: 15px; display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-size: 0.95rem; color: var(--primary-dark); font-weight: bold;">¿El
                                alumno ya existe en el sistema?</span>
                            <div style="display: flex; gap: 8px;">
                                <button type="button" id="btnAbrirSeleccion"
                                    style="background: #16a34a; padding: 8px 12px; font-size: 0.85rem; color: white; border: none; border-radius: 6px; cursor: pointer;">Seleccionar
                                    alumno</button>
                                <button type="button" id="btnBorrarSeleccion" class="hidden"
                                    style="background: #f97316; padding: 8px 12px; font-size: 0.85rem; color: white; border: none; border-radius: 6px; cursor: pointer;">Borrar
                                    selección</button>
                            </div>
                        </div>
                        <div class="grid">
                            <div>
                                <label for="usuarioAlumno">Número de control</label>
                                <input type="text" id="usuarioAlumno" placeholder="Ej. 20000001"
                                    pattern="\d{8,}"
                                    title="Debe contener mínimo 8 números" required />
                            </div>
                            <div>
                                <label for="password_estudiante" id="lbl_pass_est">Contraseña (AñoMesDía)</label>
                                <input type="text" id="password_estudiante" placeholder="Ej. 200241"
                                    pattern="\d{6,}" title="Mínimo 6 números (sin letras)" required />
                            </div>
                            <div>
                                <label for="nombre">Nombre completo</label>
                                <input type="text" id="nombre" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                    title="Solo letras y espacios" placeholder="Ej. Juan Pérez" required />
                            </div>
                            <div>
                                <label for="correo">Correo (Opcional)</label>
                                <input type="email" id="correo" placeholder="ejemplo@dominio.com" />
                            </div>
                            <div>
                                <label for="programa">Programa</label>
                                <select id="programa" required>
                                    <option value="" selected disabled>Selecciona...</option>
                                    <option value="Maestría">Maestría</option>
                                    <option value="Doctorado">Doctorado</option>
                                </select>
                            </div>
                            <div>
                                <label for="titulo">Título del proyecto</label>
                                <input type="text" id="titulo" required />
                            </div>
                        </div>
                        <div class="row-actions">
                            <button type="button" id="btnSiguientePaso">Siguiente ➔</button>
                        </div>
                    </fieldset>

                    <!-- PASO 2 -->
                    <fieldset id="fsPaso2" class="hidden">
                        <legend>2) Información del seminario</legend>
                        <div class="grid">

                            <div
                                style="background: #eff6ff; padding: 10px; border-radius: 8px; border: 1px dashed var(--primary); grid-column: 1 / -1;">
                                <label for="clave_acceso"
                                    style="color: var(--primary-dark); font-weight: bold;">Clave de acceso
                                    (Editable)</label>
                                <div style="display:flex; gap:5px;">
                                    <input type="text" id="clave_acceso" required
                                        placeholder="Generar o escribir clave..."
                                        style="font-family: monospace; font-size: 1.1rem; text-align: center;" />
                                    <button type="button" id="btnGenerarClave"
                                        style="padding: 10px; flex-shrink: 0; background: var(--accent); color: var(--primary-dark);"
                                        title="Generar clave">🎲</button>
                                    <button type="button" id="btnLimpiarClave"
                                        style="padding: 10px; flex-shrink: 0; background: var(--error); color: white;"
                                        title="Vaciar campo">🗑️</button>
                                </div>
                            </div>

                            <div>
                                <label for="tipo_seminario">Seminario</label>
                                <select id="tipo_seminario" required>
                                    <option value="" selected disabled>Selecciona un programa primero</option>
                                </select>
                            </div>
                            <div>
                                <label for="modalidad">Modalidad</label>
                                <select id="modalidad" required>
                                    <option value="Presencial">Presencial</option>
                                    <option value="Virtual">Virtual</option>
                                </select>
                            </div>

                            <div>
                                <label for="lugar_select">Aula / Modalidad del lugar</label>
                                <select id="lugar_select" required>
                                    <option value="" selected disabled>Selecciona...</option>
                                    <option value="Raúl Limón">Aula Raúl Limón</option>
                                    <option value="Fermín Carrillo">Aula Fermín Carrillo</option>
                                    <option value="Virtual">Virtual (Google Meet / Zoom)</option>
                                    <option value="Personalizado">Personalizado (escribir aula)</option>
                                </select>
                                <input type="text" id="lugar_virtual" class="hidden" style="margin-top:6px;"
                                    placeholder="Pega el enlace de Meet, Zoom, etc." />
                                <input type="text" id="lugar_personalizado" class="hidden" style="margin-top:6px;"
                                    placeholder="Escribe el aula específica" />
                            </div>
                            <div>
                                <label for="duracion_select">Duración</label>
                                <select id="duracion_select" required>
                                    <option value="" selected disabled>Selecciona...</option>
                                    <option value="30">30 min</option>
                                    <option value="40">40 min</option>
                                    <option value="60">60 min</option>
                                    <option value="Personalizado">Personalizado</option>
                                </select>
                                <input type="number" id="duracion_personalizada" class="hidden"
                                    style="margin-top:6px;" placeholder="Ej. 45, 90..." min="1" />
                            </div>

                            <div>
                                <label for="fecha">Fecha</label>
                                <input type="date" id="fecha" required>
                            </div>
                            <div>
                                <label for="hora">Hora</label>
                                <input type="time" id="hora" required>
                            </div>

                            <div>
                                <label for="presidente">Presidente del jurado (Opcional)</label>
                                <input type="text" id="presidente" />
                            </div>
                            <div>
                                <label for="secretario">Secretario (Opcional)</label>
                                <input type="text" id="secretario" />
                            </div>
                            <div>
                                <label for="vocal">Vocal (Opcional)</label>
                                <input type="text" id="vocal" />
                            </div>

                            <div>
                                <label for="observaciones">Observaciones (Opcional)</label>
                                <input type="text" id="observaciones" />
                            </div>
                        </div>

                        <div class="row-actions">
                            <button type="button" id="btnRegresarPaso" style="background: #6b7280;">🡄
                                Regresar</button>
                            <button type="submit" id="btnGuardarFinal">Agendar y guardar</button>
                        </div>
                    </fieldset>
                </form>

                <div id="panelAdmin" class="card hidden"
                    style="margin-bottom: 20px; border-top: 4px solid var(--primary); margin-top: 20px;">
