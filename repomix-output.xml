                </div>
            </div>
        </section>

        <div style="display:flex; justify-content:flex-end; align-items:center; gap:10px; margin-bottom: 12px; flex-wrap: wrap;">
            <label for="selector-programa-seminarios" style="margin:0; white-space:nowrap;">Programa:</label>
            <select id="selector-programa-seminarios" style="max-width: 160px;"></select>
            <label for="selector-anio-seminarios" style="margin:0; white-space:nowrap;">Filtrar por año:</label>
