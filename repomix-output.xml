    color: var(--primary);
    font-size: 1.4rem;
    margin-bottom: 5px;
    text-align: center;
}

.login-form .form-subtitle {
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
    margin-bottom: 25px;
    line-height: 1.3;
}

.input-group {
    margin-bottom: 20px;
}

.input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text);
}

.input-group input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.95rem;
    transition: border-color 0.2s;
}

.form-hint {
    display: block;
    margin-top: 4px;
    font-size: 0.78rem;
    color: var(--muted);
}

.input-group input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(27, 57, 106, 0.1);
}

.btn-submit {
    width: 100%;
    background-color: var(--primary);
    color: white;
    border: none;
    padding: 12px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.2s;
    margin-top: 10px;
}

.btn-submit:hover {
    background-color: var(--primary-dark);
}

/* Enlace para cambiar de rol dentro de estudiante */
.switch-role-container {
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px dashed var(--border);
    text-align: center;
}

.btn-switch-link {
    background: none;
    border: none;
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    transition: color 0.2s;
    text-align: center;
}

.btn-switch-link:hover {
    color: var(--accent);
}

/* Footer */
footer {
    background: #111827;
    color: #9ca3af;
    text-align: center;
    padding: 15px;
    font-size: 0.8rem;
    border-top: 3px solid var(--accent);
}

.login-error {
    color: #b91c1c;
    background: #fee2e2;
    border: 1px solid #fca5a5;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-top: 14px;
    text-align: center;
}

.login-error.hidden {
    display: none;
}

/* --- Estilos para botón de ver contraseña --- */
.password-container {
    position: relative;
    display: flex;
    align-items: center;
}

.password-container input {
    width: 100%;
    padding-right: 40px;
}

.btn-toggle-password {
    position: absolute;
    right: 10px;
    background: none;
    border: none;
    color: var(--muted);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0;
    margin: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
}

.btn-toggle-password:hover {
    color: var(--primary);
}

/* --- Modal de aviso --- */
#modalAvisoGlobal.hidden {
    display: none;
}

#modalAvisoGlobal {
    position: fixed;
    top: 0;
    left: 0;
