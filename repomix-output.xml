        nombre=caso["nombre"],
        correo=generar_correo(caso["control"], caso.get("con_correo", True)),
        programa=caso["programa"],
    )
    session.add(estudiante)
    session.flush()
    return estudiante


def _crear_seminario_demo(session, estudiante, fecha_hora, fase, programa_seminario=None):
