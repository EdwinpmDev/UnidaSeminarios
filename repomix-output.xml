                  pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü\s]+" title="Solo letras y espacios, sin números ni símbolos" required />
                <small class="form-hint">Solo letras y espacios. Sin números ni símbolos.</small>
              </div>
              <div class="input-group">
                <input type="email" id="reg-correo" placeholder="Correo institucional" required />
                <small class="form-hint">Debe incluir @ y un dominio, ej. ejemplo@veracruz.tecnm.mx</small>
              </div>
              <div class="input-group" style="margin-bottom: 20px;">
                <select id="reg-programa"
                  style="width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.95rem; background: #fff;"
                  required>
                  <option value="" disabled selected>Selecciona tu programa</option>
                  <option value="Maestría">Maestría</option>
                  <option value="Doctorado">Doctorado</option>
                </select>
              </div>
              <div class="input-group">
                <div class="password-container">
                  <input type="password" id="reg-pass" placeholder="Ej. 200499"
                    pattern="\d{6,}" title="Debe contener mínimo 6 números" required />
                  <button type="button" class="btn-toggle-password" tabindex="-1"
                    title="Mostrar contraseña">👁️</button>
                </div>
              </div>
              <small class="form-hint">Mínimo 6 números. Solo números, sin letras ni símbolos.</small>

              <button type="submit" class="btn-submit" id="btn-submit-registro">Registrarme</button>
              <p class="login-error hidden" id="error-registro"></p>
              <p class="login-error hidden" id="exito-registro"
                style="background: #dcfce7; color: #166534; border-color: #bbf7d0;"></p>
            </form>

            <div class="switch-role-container">
              <button type="button" class="btn-switch-link" data-subrol="estudiante">
                Ya tengo cuenta. Regresar al login.
              </button>
            </div>
          </div>

          <!-- 3. EVALUACIÓN ESTUDIANTE -->
          <div id="sub-form-invitado" class="sub-form-content">
            <form class="login-form" action="/login-alumno-evaluador" method="POST" id="form-alumno-evaluador">
              <h3>Evaluación Estudiantil</h3>
              <p class="form-subtitle">Ingresa tus datos y la clave del seminario para evaluar a tu compañero.</p>

              <div class="input-group">
                <label>No. de Control</label>
                <input type="text" id="eval-control" pattern="\d{8,}" title="Debe contener mínimo 8 números" required />
              </div>
              <div class="input-group">
                <label>Contraseña</label>
                <div class="password-container">
                  <input type="password" id="eval-pass" required />
                  <button type="button" class="btn-toggle-password" tabindex="-1">👁️</button>
                </div>
              </div>
              <div class="input-group">
                <label>Clave del Seminario</label>
                <input type="text" id="eval-clave" style="text-align: center; font-family: monospace;" required />
              </div>

              <button type="submit" class="btn-submit">Ingresar a evaluar</button>
              <p class="login-error hidden" id="error-alumno-evaluador"></p>
            </form>

            <div class="switch-role-container">
              <button type="button" class="btn-switch-link" data-subrol="estudiante">
                Regresar al Login de Estudiantes
              </button>
            </div>
          </div>

        </div>

        <!-- TAB EVALUADOR EXTERNO  -->
        <div id="tab-evaluador" class="tab-content">
          <form class="login-form" action="/login-evaluador" method="POST">
            <h3>Evaluador Externo</h3>
            <p class="form-subtitle">Acceso rápido para la evaluación en tiempo real de seminarios.</p>

            <div class="input-group">
              <label for="code-evaluador">Clave de acceso al Seminario</label>
              <input type="text" id="code-evaluador" name="seminar_code" placeholder="canek-2026-xyz"
                style="text-align: center; font-family: monospace;" required />
            </div>

            <button type="submit" class="btn-submit">Validar e ingresar</button>
          </form>
        </div>

      </div>
    </div>
  </main>

  <footer>
    &copy; 2026 Instituto Tecnológico de Veracruz &middot; UNIDA &middot; Todos los derechos reservados.
  </footer>
  <script type="module" src="./js/login.js"></script>
  <script src="./js/compat.js"></script>
</body>

</html>
