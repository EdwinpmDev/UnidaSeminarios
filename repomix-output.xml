<file path="frontend/css/dashboard-docente.css">
:root {
    --primary: #1B396A;
    --primary-dark: #132848;
    --accent: #D4AF37;
    --bg: #f4f6f9;
    --card: #ffffff;
    --text: #1f2937;
    --muted: #6b7280;
    --border: #cbd5e1;
    --success: #16a34a;
    --error: #dc2626;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-size: 1.05rem;
}

header {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    border-bottom: 4px solid var(--accent);
}

header h1 {
    font-size: 1.3rem;
    font-weight: 800;
}

header p {
    font-size: 0.9rem;
    opacity: 0.9;
    margin-top: 4px;
}

header p #nombre-docente {
    font-weight: 800;
    opacity: 1;
}

.btn-salir {
    background: var(--error);
    color: white;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    font-family: inherit;
}

main {
    flex: 1;
    max-width: 700px;
    width: 100%;
    margin: 0 auto;
    padding: 20px 15px 40px;
}

.tarjeta {
    background: var(--card);
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 6px 12px -3px rgba(0, 0, 0, 0.05);
}

.filtro-mes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
}

.filtro-mes label {
    font-weight: 700;
    color: var(--primary-dark);
}

.filtro-mes input[type="month"] {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
}

.titulo-mes {
    text-align: center;
    font-weight: 800;
    color: var(--primary);
    font-size: 1.15rem;
    margin-bottom: 15px;
    text-transform: capitalize;
}

.calendario-cabecera {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-weight: 700;
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 6px;
}

.calendario-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
}

.dia-celda {
    aspect-ratio: 1;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 600;
    position: relative;
}

.dia-celda.vacio {
    background: transparent;
    border: none;
}

.dia-celda.con-seminarios {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: var(--primary-dark);
    cursor: pointer;
}

.dia-celda.con-seminarios:hover {
    background: var(--primary);
    color: white;
}

.dia-celda.seleccionado {
    background: var(--primary);
    color: white;
    border-color: var(--primary-dark);
}

.punto-indicador {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 3px;
}

.mensaje-vacio {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--muted);
    padding: 20px 0;
    font-size: 0.9rem;
}

/* --- Tarjeta de seminario en la lista del día --- */
.item-seminario {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 10px;
    cursor: pointer;
    gap: 10px;
}

.item-seminario:hover {
