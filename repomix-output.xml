<file path="frontend/css/usuario.css">
:root {
    --bg: #f6f8fa;
    --card: #ffffff;
    --text: #1f2937;
    --muted: #6b7280;
    --primary: #1B396A;
    /* Azul TecNM */
    --primary-dark: #132848;
    /* Derivado para hover/gradiente */
    --ok: #16a34a;
    --error: #dc2626;
    --border: #e5e7eb;
}

* {
    box-sizing: border-box
}

/* Evita que texto largo (comentarios, proyectos, enlaces) se salga de sus contenedores */

p,
td,
th,
li,
span,
div,
label {
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* Caja de texto con desplazamiento dependiendo de la cantidad de texto */
.texto-scroll {
    max-height: 170px;
    overflow-y: auto;
    white-space: pre-wrap;
    padding-right: 6px;
}

.texto-scroll::-webkit-scrollbar {
    width: 6px;
}

.texto-scroll::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
}

body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, "Noto Sans", "Helvetica Neue", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.4;
}

/* ----- Encabezado con logos (página) --- */
header {
    position: relative;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    padding: 92px 16px 28px;
    text-align: center;
}

.brand-left {
    position: absolute;
    top: 12px;
    left: 16px;
    z-index: 2;
}

.brand-left img {
    height: 48px;
    width: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .25));
}

.brand-center {
    position: absolute;
    top: 6px;
    left: 0;
    right: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    pointer-events: none;
}

.brand-center img {
    height: 72px;
    width: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, .25));
}

header h1 {
    margin: 8px 0 6px;
    font-size: 1.8rem;
    font-weight: 800
}

header p {
    margin: 0;
    opacity: .95
}

@media (max-width:600px) {
    .brand-left img {
        height: 40px;
    }

    .brand-center img {
        height: 62px;
    }

    header {
        padding-top: 86px;
    }
}

.container {
    max-width: 960px;
    margin: 24px auto 60px;
    padding: 0 16px;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, .04);
}

.steps {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: .95rem;
}

.steps .step {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: #fff;
    color: #6b7280;
}

.steps .step.active {
    background: rgba(27, 57, 106, .10);
    border-color: rgba(27, 57, 106, .35);
    color: var(--primary-dark);
    font-weight: 600;
}

fieldset {
    border: none;
    padding: 0;
    margin: 14px 0 2px;
}

legend {
    font-weight: 700;
    margin-bottom: 8px;
    font-size: 1.05rem;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

@media (max-width:720px) {
    .grid {
        grid-template-columns: 1fr;
    }
}

label {
    display: block;
    font-size: .9rem;
    color: #6b7280;
    margin-bottom: 6px;
}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="date"],
input[type="time"],
select {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 1rem;
    background: #fff;
    outline: none;
    transition: border .15s, box-shadow .15s;
}

input[type="text"]:focus,
input[type="email"]:focus,
input[type="password"]:focus,
select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(27, 57, 106, .12);
}

/* Estilos para el botón de cerrar sesión */
.btn-logout {
    background: transparent;
    color: var(--error);
    border: 2px solid var(--error);
    padding: 8px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-logout:hover {
    background: var(--error);
    color: #fff;
    transform: translateY(-1px);
}

.hidden {
    display: none !important;
}

.radio-list {
    display: grid;
    gap: 10px;
}

.radio-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
}

.radio-item input {
    accent-color: var(--primary);
}

.row-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 14px;
}

button {
    appearance: none;
    border: none;
    background: var(--primary);
    color: #fff;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 1rem;
    cursor: pointer;
    transition: transform .05s, background .15s, opacity .15s;
}

button:hover {
    background: var(--primary-dark);
}

button:active {
    transform: translateY(1px);
}

button[disabled] {
    opacity: .6;
    cursor: not-allowed;
}

.error {
    color: #dc2626;
    font-size: .9rem;
    margin-top: 8px;
}

.success {
    border-left: 4px solid var(--ok);
    background: #ecfdf5;
    padding: 12px;
    border-radius: 10px;
    margin-top: 16px;
}

.summary {
    margin-top: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
    background: #fff;
}

.summary dt {
    font-weight: 700;
}

.summary dd {
    margin: 0 0 8px 0;
}

/* ---- Overlay de Login (bloquea la UI hasta autenticación) --- */
#loginOverlay {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, .45);
    z-index: 9999;
    padding: 16px;
}

#loginBox {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    width: min(420px, 92%);
    padding: 16px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, .18);
}

#loginBox h2 {
    margin: 0 0 10px;
    font-size: 1.2rem;
}

#loginBox .grid {
    display: grid;
    gap: 10px;
}

#loginBox .row-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 8px;
}

#loginError {
    color: var(--error);
    font-size: .9rem;
    margin-top: 8px;
}


/* --- Estilos para botón de ver contraseña --- */
.password-container {
    position: relative;
    display: block;
    /* Mantencion de display block */
    width: 100%;
}

.password-container input {
    width: 100%;
    /* Mantener el padding original del diseño */
    padding-right: 40px !important;
}

.btn-toggle-password {
    position: absolute;
    right: 8px;
    /* Pegado a la derecha, dentro del input */
    top: 50%;
    transform: translateY(-50%);
    /* Centrado verticalmente */
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
    outline: none;
}

.btn-toggle-password:hover {
    color: var(--primary);
    background: transparent;
}

.btn-toggle-password:active {
    transform: translateY(-50%) !important;
}

/* Estilos para la tabla de selección de alumnos */
.table-scroll-container {
    overflow-x: auto;
    max-height: 400px;
    overflow-y: auto;
}

#tablaSeleccionBody tr td {
    padding: 10px 8px;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
}

#tablaSeleccionBody tr:hover {
    background: #f8fafc;
}

.modal-overlay {
    align-items: center;
    overflow: hidden;
    padding: 15px;
}

.modal-content {
    max-height: 85vh;
    overflow-y: auto;
}

#tablaEstudiantesBody td, #tablaEstudiantesBody th, #tablaSeleccionBody td {
    white-space: nowrap;
}

@media (max-width: 600px) {
    .row-actions { flex-direction: column; width: 100%; }
    .row-actions button { width: 100%; margin-bottom: 5px; }
    .filtro-mes { flex-direction: column; align-items: stretch; }
    .filtro-mes input[type="month"] { width: 100%; margin-top: 8px; }
    header { padding-top: 100px; }
}


/* VISTA DOCENTES */

/* --- Encabezado de la sección --- */
.vista-docentes-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.vista-docentes-titulo {
    margin: 0;
    color: var(--primary-dark);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
}

/* --- Jerarquía de botones de acción --- */
.btn-primary-action {
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(27, 57, 106, .25);
}

.btn-primary-action:hover {
    background: var(--primary-dark);
    box-shadow: 0 4px 14px rgba(27, 57, 106, .32);
}

.btn-secondary-action {
    background: #fff;
    color: var(--primary-dark);
    border: 1.5px solid var(--primary);
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 8px;
    white-space: nowrap;
}

.btn-secondary-action:hover {
    background: rgba(27, 57, 106, .06);
}

.btn-tertiary-action {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    font-weight: 500;
    padding: 9px 14px;
    border-radius: 8px;
}

.btn-tertiary-action:hover {
    background: #f1f5f9;
    color: var(--text);
}

/* Botón de peligro (usado en "Eliminar") */
.btn-danger {
    background: var(--error);
    color: #fff;
}

.btn-danger:hover {
    background: #b91c1c;
}

/* --- Buscador con icono de lupa --- */
.buscador-docentes-wrapper {
    position: relative;
    flex: 1;
}

.buscador-docentes-wrapper::before {
    content: "🔍";
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: .95rem;
    opacity: .55;
    pointer-events: none;
}

.buscador-docentes-wrapper input {
    padding-left: 36px !important;
}

/* --- Tabla de docentes --- */
.tabla-docentes {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

.tabla-docentes thead tr {
    background: #eef2f7;
}

.tabla-docentes thead th {
    padding: 10px 12px;
    font-weight: 700;
    color: var(--primary-dark);
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .03em;
    border-bottom: 2px solid var(--border);
}

.tabla-docentes tbody tr {
    border-bottom: 1px solid #eee;
    transition: background .1s;
}

.tabla-docentes tbody tr:nth-child(even) {
    background: #f8fafc;
}

.tabla-docentes tbody tr:hover {
    background: rgba(27, 57, 106, .06);
}

.tabla-docentes td {
    padding: 10px 12px;
    vertical-align: middle;
}

.docente-nombre {
    font-weight: 700;
    color: var(--text);
}

.docente-usuario {
    color: var(--muted);
    font-size: .92rem;
}

.badge-evaluaciones {
    display: inline-block;
    background: rgba(27, 57, 106, .1);
    color: var(--primary-dark);
    font-weight: 700;
    font-size: .78rem;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
}

.docente-acciones {
    display: flex;
    gap: 6px;
}

.btn-editar-docente {
    background: #d97706;
    color: #fff;
    padding: 6px 12px;
    font-size: .82rem;
    border-radius: 6px;
    font-weight: 600;
}

.btn-editar-docente:hover {
    background: #b45309;
}

.btn-eliminar-docente {
    padding: 6px 12px;
    font-size: .82rem;
    border-radius: 6px;
    font-weight: 600;
}

/* --- Encabezado de página más compacto en tablet/móvil --- */
@media (max-width: 720px) {
    header {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 20px;
    }

    header h1 {
        font-size: 1.4rem;
        margin: 6px 0 4px;
    }

    header p {
        font-size: .85rem;
    }
}

/* --- Responsive: tabla de docentes - tarjetas apiladas --- */
@media (max-width: 720px) {
    .vista-docentes-header {
        flex-direction: column;
        align-items: stretch;
    }

    .vista-docentes-titulo {
        font-size: 1.3rem;
        text-align: center;
    }

    .tabla-docentes thead {
        display: none;
    }

    .tabla-docentes,
    .tabla-docentes tbody,
    .tabla-docentes tr,
    .tabla-docentes td {
        display: block;
        width: 100%;
    }

    .tabla-docentes tbody tr {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        margin-bottom: 12px;
        padding: 12px 14px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .05);
    }

    .tabla-docentes tbody tr:nth-child(even) {
        background: #fff;
    }

    .tabla-docentes td {
        padding: 4px 0;
        border: none;
    }

    .docente-nombre {
        font-size: 1.05rem;
        display: block;
    }

    .docente-usuario {
        display: block;
    }

    .docente-acciones {
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .docente-acciones button {
        flex: 1 1 auto;
        min-width: 110px;
        text-align: center;
    }
}

/* --- Modal de edición de docente: espacio para teclado móvil --- */
@media (max-width: 720px) {
    #modalEditarDocente>div {
        max-height: 88vh;
        overflow-y: auto;
    }
}

/* --- Toast --- */
#toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 2000;
    pointer-events: none;
}

.toast {
    background: #1f2937;
    color: #ffffff;
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 0.9rem;
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.25);
    max-width: 320px;
    word-break: break-word;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    border-left: 4px solid var(--primary);
}

.toast-visible {
    opacity: 1;
    transform: translateY(0);
}

.toast-exito {
    border-left-color: #059669;
}

.toast-error {
    border-left-color: #dc2626;
}
</file>

<file path="frontend/evaluacion.html">
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UNIDA — Evaluación de Seminarios</title>
  <link rel="stylesheet" href="./css/evaluacion.css">
</head>

<body>

  <button id="btnSalirEvaluacion" class="hidden">
    Cerrar sesión / Salir
  </button>

  <header>
    <h1>UNIDA — SISTEMA DE SEMINARIOS DE POSGRADO</h1>
    <p>Cédula Oficial de Evaluación del Sínodo</p>
  </header>

  <div id="bannerEnviado" class="hidden">
    ✅ Evaluación enviada correctamente. Puedes revisar tus respuestas abajo. Cuando termines, pulsa "Cerrar sesión /
    Salir" arriba para liberar el equipo.
  </div>

  <main>

    <!-- PASO 0: Identificación del evaluador -->
    <div class="wizard-card" id="gate-posicion">
      <div class="step-title">Identificación del Evaluador</div>
      <p style="color: var(--muted); font-size: 0.9rem; margin-bottom: 15px;">
        Por favor, selecciona tu rol en el sínodo y escribe tu nombre completo antes de comenzar la evaluación.
      </p>

      <div class="form-group">
        <label for="evaluador_nombre">Nombre completo (con título) *</label>
        <input type="text" id="evaluador_nombre" placeholder="Ej. Dr. Francisco Acosta" required>
      </div>

      <p id="errorPosicion" class="hidden" style="color: var(--error); font-size: 0.85rem; margin-bottom: 10px;"></p>
      <button type="button" id="btnValidarPosicion" class="btn-submit" disabled>Comenzar Evaluación</button>
    </div>

    <!-- TARJETA DE EVALUACIÓN -->
    <div class="wizard-card hidden" id="tarjeta-evaluacion">
      <form id="evalForm">
        <!-- Se guarda el rol seleccionado aquí en secreto para mandarlo al servidor -->
        <input type="hidden" id="evaluador_rol_fijo" value="">

        <div
          style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 15px; margin-bottom: 20px; text-align: center;">
          <h3 style="margin: 0; color: var(--primary-dark); font-size: 1.1rem;">Evaluador: <span
              id="display-nombre-evaluador" style="color: var(--primary);"></span></h3>
        </div>

        <div class="step-section disabled" id="sec-paso1">
          <div class="step-title">Paso 1: Datos del Evaluado</div>
          <div class="form-group">
            <label for="select-evaluado">Estudiante</label>
            <select id="select-evaluado" disabled>
              <option value="">Cargando datos seguros...</option>
            </select>
          </div>
          <div class="form-group">
            <label>Título del proyecto</label>
            <input type="text" id="proyecto_titulo" disabled>
          </div>
          <div class="form-group">
            <label>Programa académico</label>
            <input type="text" id="proyecto_programa" disabled>
          </div>
        </div>

        <div class="step-section disabled" id="sec-paso2">
          <div class="step-title">Paso 2: Seminario Asignado</div>
          <div class="form-group">
            <label>Fase de avance</label>
            <div class="radio-container" id="contenedor-seminarios-dinamicos">
            </div>
          </div>
        </div>

        <div class="step-section disabled" id="sec-paso3">
          <div class="step-title">Paso 3: Criterios de evaluación oficiales</div>

          <h4 id="subtitulo-oral" style="font-size:0.9rem; color:var(--primary); margin-bottom:15px;">I. Exposición Oral (P1 a P8 — Escala
            del 1 al 10)</h4>
          <div id="quest-container-10"></div>

          <h4 id="subtitulo-escrito" style="font-size:0.9rem; color:var(--primary); margin: 25px 0 15px;">II. Reporte escrito y debate (P9 a
            P12 — Escala del 1 al 5)</h4>
          <div id="quest-container-5"></div>

          <div id="contenedor-calificacion-directa" class="hidden form-group" style="margin-top: 25px;">
            <label style="color: var(--primary-dark);" for="calificacion_directa">Calificación directa de la fase (0 a 100) *</label>
            <input type="number" id="calificacion_directa" min="0" max="100" step="0.1"
              placeholder="Ej. 95.5">
          </div>

          <div class="form-group" style="margin-top: 25px;">
            <label style="color: var(--primary-dark);" for="txt-comentarios">Observaciones y retroalimentación (Mínimo
              50 caracteres) *</label>
            <textarea id="txt-comentarios" rows="4"
              placeholder="Ingrese detalladamente los comentarios y correcciones del sínodo..." required></textarea>
            <div id="comentarios-info" class="char-counter">0 / 50 caracteres</div>
          </div>
        </div>

        <button type="submit" id="btn-enviar-todo" class="btn-submit" disabled>Enviar evaluación final</button>
      </form>
    </div>
  </main>

  <footer>
    &copy; 2026 Instituto Tecnológico de Veracruz &middot; UNIDA &middot; Todos los derechos reservados.
  </footer>
  <script type="module" src="./js/evaluacion.js"></script>
</body>

</html>
</file>

