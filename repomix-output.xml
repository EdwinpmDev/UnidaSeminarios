                </div>
                <div><label>No. Control:</label>
                    <p id="lbl-usuarioAlumno">---</p>
                </div>
                <div>
                    <label>Correo institucional:</label>
                    <div id="vista-correo" style="display:flex; align-items:center; gap:10px; flex-wrap: wrap;">
                        <p id="lbl-correo" style="margin:0;">---</p>
                        <button type="button" id="btnEditarCorreo" style="background:none; border:1px solid var(--primary); color: var(--primary); padding: 3px 10px; border-radius: 6px; cursor:pointer; font-size:0.8rem;">✏️ Editar</button>
                    </div>
                    <div id="edicion-correo" style="display:none; gap:8px; margin-top:6px; flex-wrap: wrap;">
                        <input type="email" id="input-nuevo-correo" placeholder="tucorreo@ejemplo.com" style="padding:6px 10px; border:1px solid var(--border); border-radius:6px; flex:1; min-width:200px;">
                        <button type="button" id="btnGuardarCorreo" style="background: var(--primary); color:white; border:none; padding:6px 14px; border-radius:6px; cursor:pointer; font-weight:bold;">Guardar</button>
                        <button type="button" id="btnCancelarCorreo" style="background:#e5e7eb; color:#374151; border:none; padding:6px 14px; border-radius:6px; cursor:pointer;">Cancelar</button>
                    </div>
                    <p id="msg-correo" style="display:none; margin:6px 0 0; font-size:0.85rem;"></p>
                </div>
                <div><label>Programa:</label>
