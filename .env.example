# .env.example - Copiar a .env y llenar con los datos necesarios
DEBUG=False
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/unida_seminarios
ADMIN_USER=nombreDelUsuario
ADMIN_PASS=contraseña_segura
JWT_SECRET=clave_segura_aqui

# Fuerza cookies Secure (requiere HTTPS). Dejar en True en producción.
FORCE_SECURE_COOKIES=True

# Cifrado de backups (opcional)
# Fingerprint de 40 caracteres de la clave GPG del destinatario.
# Si no se define, los backups se guardan sin cifrar.
BACKUP_GPG_RECIPIENT=

# Rate limiting con Redis (opcional)
# Si no se define, el rate limiting cae a memoria local (no funciona con múltiples workers).
REDIS_URL=

# CORS para dominio real (opcional)
# Dominio(s) desde los que se accede al sistema, separados por coma.
# Ejemplo: https://unida.itver.edu.mx,https://otro-dominio.com
CORS_ORIGINS_EXTRA=

# Número de proxies inversos delante del servidor (opcional)
# Poner 1 si hay Nginx, Caddy, un balanceador, etc.
# Dejar en 0 si Flask recibe las peticiones directo.
NUM_PROXIES=0